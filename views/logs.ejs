<!DOCTYPE html>
<html lang="pt">
<head>
    <script>
        // Aplicar o tema guardado ANTES da página renderizar para evitar flash branco
        const savedTheme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', savedTheme);
    </script>
    <link rel="stylesheet" href="/style.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Logs de Auditoria - Admin</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: var(--bg-color, #f4f6f9); margin: 0; padding: 20px; color: var(--text-color, #333); transition: background 0.3s, color 0.3s; }
        .container { max-width: 1000px; margin: 0 auto; background: var(--card-bg, white); padding: 20px; border-radius: 10px; box-shadow: 0 2px 6px rgba(0,0,0,0.05); transition: background 0.3s; }
        h2 { margin-top: 0; color: var(--text-color, #333); border-bottom: 2px solid var(--border-color, #f0f0f0); padding-bottom: 10px; }
        .back-link { display: inline-block; margin-bottom: 15px; color: #0056b3; text-decoration: none; font-weight: bold; }
        
        table { width: 100%; border-collapse: collapse; font-size: 13px; margin-top: 10px; color: var(--text-color, #333); }
        th, td { padding: 10px; text-align: left; border-bottom: 1px solid var(--border-color, #eee); }
        th { background: var(--table-header, #fafafa); color: var(--text-color, #555); }
        
        .badge { padding: 3px 8px; border-radius: 4px; font-size: 11px; font-weight: bold; color: white; }
        .bg-edit { background: #ffc107; color: #333; }
        .bg-add { background: #28a745; }
        .bg-del { background: #dc3545; }

        .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; }
        #theme-toggle {
            background: var(--border-color, #ddd);
            border: none;
            border-radius: 50%;
            width: 36px;
            height: 36px;
            font-size: 16px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="top-bar">
            <a href="/admin/importar" class="back-link" style="margin-bottom: 0;">← Voltar ao Painel de Importação</a>
            <button id="theme-toggle" onclick="toggleGlobalTheme()" title="Alternar Modo Noturno">🌙</button>
        </div>

        <h2>📜 Logs de Auditoria de Alterações</h2>
        <table>
            <thead>
                <tr>
                    <th>Data/Hora</th>
                    <th>Utilizador (@username)</th>
                    <th>Ação</th>
                    <th>Detalhes</th>
                </tr>
            </thead>
            <tbody>
                <% if (logs && logs.length > 0) { %>
                    <% logs.forEach(l => { %>
                        <tr>
                            <td><%= l.timestamp %></td>
                            <td><strong><%= l.nome_completo %></strong> (<%= l.username %>)</td>
                            <td>
                                <span class="badge <%= l.acao.includes('EDITOU') ? 'bg-edit' : (l.acao.includes('ADICIONOU') ? 'bg-add' : 'bg-del') %>">
                                    <%= l.acao %>
                                </span>
                            </td>
                            <td><%= l.detalhes %></td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="4" style="text-align: center; color: var(--text-muted, #777);">Sem logs registados.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <script>
        window.addEventListener('DOMContentLoaded', () => {
            const btn = document.getElementById('theme-toggle');
            if (btn) {
                const current = document.documentElement.getAttribute('data-theme');
                btn.textContent = current === 'dark' ? '☀️' : '🌙';
            }
        });

        function toggleGlobalTheme() {
            const currentTheme = document.documentElement.getAttribute('data-theme');
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            
            document.documentElement.setAttribute('data-theme', newTheme);
            localStorage.setItem('theme', newTheme);

            const btn = document.getElementById('theme-toggle');
            if (btn) {
                btn.textContent = newTheme === 'dark' ? '☀️' : '🌙';
            }
        }
    </script>
</body>
</html>