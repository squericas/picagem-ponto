<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal do Funcionário</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #f4f6f9; margin: 0; padding: 15px; color: #333; }
        .header { display: flex; justify-content: space-between; align-items: center; background: white; padding: 15px; border-radius: 10px; box-shadow: 0 2px 6px rgba(0,0,0,0.05); margin-bottom: 15px; }
        .header h2 { margin: 0; font-size: 18px; color: #333; }
        .header p { margin: 5px 0 0 0; font-size: 13px; color: #666; }
        .logout { color: #d9534f; text-decoration: none; font-weight: bold; font-size: 14px; }
        
        .ponto-box { background: white; padding: 20px; border-radius: 10px; box-shadow: 0 2px 6px rgba(0,0,0,0.05); text-align: center; margin-bottom: 15px; }
        .btn-ponto { width: 100%; padding: 16px; font-size: 18px; font-weight: bold; color: white; border: none; border-radius: 8px; cursor: pointer; margin-bottom: 10px; }
        .btn-entrada { background: #28a745; }
        .btn-saida { background: #dc3545; }
        
        .section { background: white; padding: 15px; border-radius: 10px; box-shadow: 0 2px 6px rgba(0,0,0,0.05); margin-bottom: 15px; overflow-x: auto; }
        h3 { margin-top: 0; font-size: 16px; color: #444; border-bottom: 2px solid #f0f0f0; padding-bottom: 8px; }
        
        table { width: 100%; border-collapse: collapse; font-size: 13px; min-width: 300px; }
        th, td { padding: 10px; text-align: left; border-bottom: 1px solid #eee; }
        th { background: #fafafa; color: #555; }
        
        ul { padding-left: 20px; font-size: 13px; color: #555; margin: 0; }
        li { margin-bottom: 5px; }
        .admin-link { display: inline-block; background: #e7f1ff; color: #0056b3; padding: 6px 12px; border-radius: 6px; text-decoration: none; font-weight: bold; font-size: 13px; margin-bottom: 15px; }
        
        .form-group { margin-bottom: 10px; text-align: left; }
        .form-group label { display: block; font-size: 12px; color: #666; margin-bottom: 3px; }
        .form-control { width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 6px; box-sizing: border-box; font-size: 13px; }
        .btn-submit { background: #007bff; color: white; border: none; padding: 10px 15px; border-radius: 6px; font-weight: bold; cursor: pointer; width: 100%; font-size: 14px; }
        .btn-submit:hover { background: #0056b3; }
        .grid-forms { display: grid; grid-template-columns: 1fr; gap: 15px; }
        @media (min-width: 600px) { .grid-forms { grid-template-columns: 1fr 1fr; } }
    </style>
</head>
<body>
    <div class="header">
        <div>
            <h2><%= user.nome_completo %></h2>
            <p>@<%= user.username %></p>
        </div>
        <a href="/logout" class="logout">Sair</a>
    </div>

    <% if (user.username === 'r.pereira') { %>
        <a href="/admin/importar" class="admin-link">⚙️ Gerir e Importar Escalas (Admin)</a>
    <% } %>

    <div class="ponto-box">
        <h3>Registar Ponto</h3>
        <form action="/picar" method="POST" style="margin-bottom: 10px;">
            <button type="submit" name="tipo" value="ENTRADA" class="btn-ponto btn-entrada">Picar ENTRADA</button>
        </form>
        <form action="/picar" method="POST">
            <button type="submit" name="tipo" value="SAIDA" class="btn-ponto btn-saida">Picar SAÍDA</button>
        </form>
    </div>

    <!-- Secção de Correção de Picagens -->
    <div class="section">
        <h3>🛠️ Corrigir ou Adicionar Picagens</h3>
        <div class="grid-forms">
            <!-- Formulário para Adicionar Picagem Em Falta -->
            <div>
                <form action="/portal/adicionar-picagem" method="POST">
                    <h4 style="font-size: 14px; margin: 0 0 10px 0; color: #555;">Adicionar Picagem Em Falta</h4>
                    <div class="form-group">
                        <label>Data:</label>
                        <input type="date" name="data" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Tipo:</label>
                        <select name="tipo" class="form-control" required>
                            <option value="ENTRADA">ENTRADA</option>
                            <option value="SAIDA">SAÍDA</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Hora (HH:MM):</label>
                        <input type="time" name="hora" class="form-control" required>
                    </div>
                    <button type="submit" class="btn-submit">Adicionar Picagem</button>
                </form>
            </div>

            <!-- Formulário para Editar Picagem Existente -->
            <div>
                <form action="/portal/editar-picagem" method="POST">
                    <h4 style="font-size: 14px; margin: 0 0 10px 0; color: #555;">Corrigir Picagem Recente</h4>
                    <div class="form-group">
                        <label>ID da Picagem:</label>
                        <input type="number" name="picagem_id" class="form-control" placeholder="Ex: ID da lista abaixo" required>
                    </div>
                    <div class="form-group">
                        <label>Novo Tipo:</label>
                        <select name="novo_tipo" class="form-control" required>
                            <option value="ENTRADA">ENTRADA</option>
                            <option value="SAIDA">SAÍDA</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Nova Hora (HH:MM):</label>
                        <input type="time" name="nova_hora" class="form-control" required>
                    </div>
                    <button type="submit" class="btn-submit" style="background: #ffc107; color: #333;">Atualizar Picagem</button>
                </form>
            </div>
        </div>
    </div>

    <div class="section">
        <h3>Resumo de Horas & Desvios</h3>
        <table>
            <thead>
                <tr>
                    <th>Data</th>
                    <th>Previsto</th>
                    <th>Real</th>
                    <th>Saldo</th>
                </tr>
            </thead>
            <tbody>
                <% if (resumo && resumo.length > 0) { %>
                    <% resumo.forEach(r => { %>
                        <tr>
                            <td><%= r.data %></td>
                            <td><%= r.previsto %></td>
                            <td><%= r.real %></td>
                            <td style="font-weight: bold; color: <%= r.minutos_desvio > 0 ? '#28a745' : (r.minutos_desvio < 0 ? '#dc3545' : '#333') %>;">
                                <%= r.minutos_desvio > 0 ? '+' : '' %><%= r.desvio_formatado %>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="4" style="text-align: center; color: #777;">Sem horários ou registos recentes.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <div class="section">
        <h3>Últimas Picagens Reais (com ID)</h3>
        <ul>
            <% if (picagens && picagens.length > 0) { %>
                <% picagens.forEach(p => { %>
                    <li><strong>[ID: <%= p.id %>] <%= p.tipo %></strong> — <%= p.timestamp %></li>
                <% }) %>
            <% } else { %>
                <li>Sem picagens registadas.</li>
            <% } %>
        </ul>
    </div>
</body>
</html>